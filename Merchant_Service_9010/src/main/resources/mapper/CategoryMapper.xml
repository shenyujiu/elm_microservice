<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eleme.merchant.mapper.CategoryMapper">

    <resultMap id="CategoryResultMap" type="com.eleme.merchant.model.CategoryDO">
        <id property="id" column="id"/>
    </resultMap>

    <select id="selectAll" resultMap="CategoryResultMap">
        SELECT DISTINCT orderTypeId AS id
        FROM business
        ORDER BY id ASC
    </select>
</mapper>
